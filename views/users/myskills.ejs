<!DOCTYPE html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My Skills | SkillSwap</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/navbar.css" rel="stylesheet">
<link rel="stylesheet" href="/css/footer.css">
<style>
    body {
        background: #f8f7fc;
        font-family: Arial, sans-serif;
        color: #17172d;
    }

    /* Header */

    .page-header {
        background: linear-gradient(120deg, #f0eaff, #edf1ff);
        padding: 35px 0;
    }

    .page-header h1 {
        font-size: 38px;
        font-weight: 800;
    }

    .page-header p {
        color: #66647a;
    }

    /* Common Card */

    .main-card {
        background: white;
        border: 1px solid #eeeaf7;
        border-radius: 13px;
        padding: 25px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    }

    .section-heading {
        color: #673de6;
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    /* Form */

    .form-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        padding: 11px;
        border: 1px solid #dcdce8;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #673de6;
        box-shadow: 0 0 0 0.15rem rgba(103,61,230,0.12);
    }

    .btn-purple {
        background: #673de6;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 8px;
    }

    .btn-purple:hover {
        background: #512bc4;
        color: white;
    }

    /* Skill Cards */

    .skill-card {
        background: white;
        border: 1px solid #eeeaf7;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        transition: 0.3s;
    }

    .skill-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(103,61,230,0.10);
    }

    .skill-icon {
        width: 60px;
        height: 60px;
        background: #eee8ff;
        color: #673de6;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .skill-name {
        font-size: 19px;
        font-weight: 700;
    }

    .category-badge {
        background: #f0eaff;
        color: #673de6;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .teach-badge {
        background: #e6f6eb;
        color: #168544;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .learn-badge {
        background: #e8efff;
        color: #2861d8;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .skill-description {
        color: #55556b;
        line-height: 1.6;
        min-height: 65px;
        margin-top: 18px;
    }

    .btn-edit {
        color: #673de6;
        border: 1px solid #673de6;
        background: white;
        padding: 8px 22px;
        border-radius: 8px;
    }

    .btn-edit:hover {
        background: #673de6;
        color: white;
    }

    .btn-delete {
        color: #dc3545;
        border: 1px solid #dc3545;
        background: white;
        padding: 8px 22px;
        border-radius: 8px;
    }

    .btn-delete:hover {
        background: #dc3545;
        color: white;
    }

    /* Empty State */

    .empty-box {
        text-align: center;
        padding: 45px 15px;
        background: #faf9ff;
        border: 1px dashed #c9b9f5;
        border-radius: 12px;
    }

    /* Footer */
/* 
    footer {
        background: #101a35;
        color: white;
        padding: 35px 0 15px;
        margin-top: 50px;
    }

    footer a {
        display: block;
        text-decoration: none;
        color: #d1d5db;
        margin-bottom: 10px;
    }

    footer a:hover {
        color: white;
    }

    .footer-bottom {
        border-top: 1px solid #39435c;
        margin-top: 25px;
        padding-top: 15px;
        text-align: center;
    }

    @media(max-width: 768px) {
        .page-header h1 {
            font-size: 30px;
        }
    } */
</style>

</head><body><!-- Navbar --><%- include("../includes/navbar.ejs") %>
  <% if(success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
 <%=success%>
 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>

<% if(error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">
 <%=error%>
 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>

<!-- Page Header --><section class="page-header">
    <div class="container">    <h1>My Skills</h1>

    <p>
        Manage your skills, share your knowledge
        and learn something new.
    </p>

</div>

</section><div class="container my-4"><!-- Add New Skill Form -->

<div class="main-card mb-4">

    <h5 class="section-heading text-primary">
        ⊕ Add New Skill
    </h5>

    <form action="/skills" method="POST">

        <div class="row g-3">

            <!-- Skill Name -->

            <div class="col-lg-3 col-md-6">

                <label class="form-label">Skill Name</label>

                <input
                    type="text"
                    name="skillName"
                    class="form-control"
                    placeholder="e.g. JavaScript, Photoshop"
                    required
                >

            </div>


            <!-- Category -->

            <div class="col-lg-3 col-md-6">

                <label class="form-label">Category</label>

                <select name="category" class="form-select" required>

                    <option value="">Select Category</option>

                    <option value="Programming">Programming & Tech</option>
                    <option value="Design">Design</option>
                    <option value="Communication">Communication</option>
                    <option value="Business">Business & Marketing</option>
                    <option value="Creative Arts">Creative Arts</option>
                    <option value="Professional Skills">Professional Skills</option>

                </select>

            </div>


            <!-- Type -->

            <div class="col-lg-3 col-md-6">

                <label class="form-label">Type</label>

                <select name="type" class="form-select" required>

                    <option value="">Select Type</option>

                    <option value="teach">Teach</option>
                    <option value="learn">Learn</option>

                </select>

            </div>


            <!-- Description -->

            <div class="col-lg-3 col-md-6">

                <label class="form-label">Description</label>

                <textarea
                    name="description"
                    class="form-control"
                    rows="2"
                    placeholder="Write a short description..."
                    required
                ></textarea>

            </div>

        </div>


        <button type="submit" class="btn btn-primary mt-3">
            + Add Skill
        </button>

    </form>

</div>

<!-- Your Skills Section -->

<div class="main-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h5 class="section-heading mb-0">
            Your Skills
            <span class="badge bg-primary rounded-pill">
                <%= skills.length %>
            </span>
        </h5>

        <span class="text-muted small">
            Total: <%= skills.length %>
        </span>

    </div>


    <div class="row g-4">

        <% if (skills.length > 0) { %>

            <% for (const skill of skills) { %>

                <div class="col-lg-4 col-md-6">

                    <div class="skill-card">

                        <div class="d-flex align-items-center gap-3 mb-3">

                            <div class="skill-icon">
                                💻
                            </div>

                            <div>

                                <h5 class="skill-name mb-2">
                                    <%= skill.skillName %>
                                </h5>

                                <div class="d-flex flex-wrap gap-2">

                                    <span class="category-badge">
                                        <%= skill.category %>
                                    </span>

                                    <% if (skill.type === "teach") { %>

                                        <span class="teach-badge">
                                            Teach
                                        </span>

                                    <% } else { %>

                                        <span class="learn-badge">
                                            Learn
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>


                        <p class="skill-description">
                            <%= skill.description %>
                        </p>

                        <hr>


                        <div class="d-flex justify-content-between">

                            <!-- Edit -->
                          <form method="get" action="/skills/<%=skill.id%>/edit">
    <button type="submit" class=" btn btn-outline-primary">✏️ Edit</button>
   </form>     
                         

                            <!-- Delete -->

                            <form method="post" action="/skills/<%=skill.id%>/delete?_method=DELETE">
   <button type="submit" class="btn btn-outline-danger ">Delete</button>
   </form>

                        </div>

                    </div>

                </div>

            <% } %>

        <% } else { %>

            <div class="col-12">

                <div class="empty-box">

                    <h3>📚 No Skills Added Yet!</h3>

                    <p class="text-muted">
                        Add your first skill and start sharing your knowledge.
                    </p>

                </div>

            </div>

        <% } %>

    </div>

</div>

</div>

<%-include("../includes/footer")%>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body>
</html>
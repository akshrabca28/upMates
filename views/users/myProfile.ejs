<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Profile - SkillSwap</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/navbar.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-5">

    <div class="card shadow border-0 mx-auto" style="max-width: 650px;">

        <div class="card-header  text-white text-center py-4" style="background-color: rgb(138, 166, 228);">
            <h2>My Profile</h2>
        </div>

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center"
                     style="width: 90px; height: 90px; font-size: 35px;">
                    <%= user.username.charAt(0).toUpperCase() %>
                </div>

                <h3 class="mt-3"><%= user.username %></h3>
                <p class="text-muted"><%= user.email %></p>
            </div>

            <hr>

            <h5>About Me</h5>
            <p class="text-muted">
                <%= user.bio || "No bio added yet." %>
            </p>

            <hr>

            <h5 class="mb-3">My Skills</h5>

            <div class="row">
                <% skills.forEach(skill => { %>
                    <div class="col-md-6 mb-3">
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <h6><%= skill.skillName %></h6>

                                <span class="badge bg-success">
                                    <%= skill.type %>
                                </span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="text-center mt-4">
                <a href="/myRequest" class="btn btn-primary">
                    My Requests
                </a>
                <a href="/editProfile" class="btn btn-warning">
    Edit Profile
</a>
            </div>

        </div>
    </div>

</div>

</body>
</html>